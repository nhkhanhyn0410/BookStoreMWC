@* Views/Shared/_BookCard.cshtml - Partial View *@
@model BookStoreMVC.Models.ViewModels.BookViewModel

@{
    var isAdminContext = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin";
    var stockStatus = Model.StockQuantity == 0 ? "out-of-stock" :
    Model.StockQuantity < 10 ? "low-stock" : "in-stock";
    var stockClass = stockStatus == "out-of-stock" ? "bg-red-100 text-red-800" :
    stockStatus == "low-stock" ? "bg-yellow-100 text-yellow-800" :
    "bg-green-100 text-green-800";
}

<div
    class="bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 group h-full flex flex-col">
    <!-- Book Image -->
    <div class="relative overflow-hidden bg-gray-100">
        <a
            href="@Url.Action(isAdminContext ? "EditBook" : "Details", isAdminContext ? "Admin" : "Books", new { id = Model.Id })">
            <img src="@(Model.ImageUrl ?? "/images/books/default-book.jpg")" alt="@Model.Title"
                class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
                onerror="this.src='/images/books/default-book.jpg'">
        </a>

        <!-- Stock Badge -->
        @if (isAdminContext)
        {
            <div class="absolute top-2 right-2">
                <span class="px-2 py-1 text-xs font-semibold rounded-full @stockClass">
                    @if (stockStatus == "out-of-stock")
                    {
                        <i class="fas fa-times-circle mr-1"></i>
                        <text>Hết hàng</text>
                    }
                    else if (stockStatus == "low-stock")
                    {
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        <text>Sắp hết</text>
                    }
                    else
                    {
                        <i class="fas fa-check-circle mr-1"></i>
                        <text>Còn hàng</text>
                    }
                </span>
            </div>
        }

        <!-- Quick Actions Overlay -->
        @if (isAdminContext)
        {
            <div
                class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                <div class="flex gap-2">
                    <a href="@Url.Action("EditBook", "Admin", new { id = Model.Id })"
                        class="px-3 py-2 bg-white text-gray-800 rounded-lg text-sm font-medium hover:bg-gray-100 transition-colors">
                        <i class="fas fa-edit mr-1"></i>Sửa
                    </a>
                    <button onclick="confirmDelete(@Model.Id, '@Html.Raw(Model.Title.Replace("'", "\\'"))')"
                        class="px-3 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors">
                        <i class="fas fa-trash mr-1"></i>Xóa
                    </button>
                </div>
            </div>
        }
        else
        {
            <div
                class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                <div class="flex gap-2">
                    <button onclick="quickView(@Model.Id)"
                        class="p-2 bg-white rounded-full hover:bg-gray-100 transition-colors">
                        <i class="fas fa-eye text-gray-800"></i>
                    </button>
                    <button onclick="addToWishlist(@Model.Id)"
                        class="p-2 bg-white rounded-full hover:bg-gray-100 transition-colors">
                        <i class="far fa-heart text-gray-800"></i>
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Book Info -->
    <div class="p-4 flex-1 flex flex-col">
        <!-- Category -->
        @if (Model.Category != null)
        {
            <div class="mb-2">
                <a href="@Url.Action("Category", "Books", new { id = Model.CategoryId })"
                    class="inline-block text-xs font-medium text-primary-600 hover:text-primary-800 transition-colors">
                    <i class="fas fa-tag mr-1"></i>@Model.Category.Name
                </a>
            </div>
        }

        <!-- Title -->
        <h3 class="text-base font-semibold text-gray-900 mb-2 line-clamp-2 min-h-[3rem]">
            <a href="@Url.Action(isAdminContext ? "EditBook" : "Details", isAdminContext ? "Admin" : "Books", new { id = Model.Id })"
                class="hover:text-primary-600 transition-colors">
                @Model.Title
            </a>
        </h3>

        <!-- Author -->
        <p class="text-sm text-gray-600 mb-3">
            <i class="fas fa-user mr-1"></i>@Model.Author
        </p>

        <!-- Rating (for public view) -->
        @if (!isAdminContext && Model.AverageRating > 0)
        {
            <div class="flex items-center mb-3">
                <div class="flex text-yellow-400 text-sm mr-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fas fa-star @(i <= Model.AverageRating ? "" : "text-gray-300")"></i>
                    }
                </div>
                <span class="text-xs text-gray-600">(@Model.ReviewCount)</span>
            </div>
        }

        <!-- Stock Info (for admin) -->
        @if (isAdminContext)
        {
            <div class="flex items-center gap-3 mb-3 text-sm">
                <div class="flex items-center text-gray-600">
                    <i class="fas fa-boxes mr-1"></i>
                    <span>Kho: <strong>@Model.StockQuantity</strong></span>
                </div>
                @if (Model.PageCount > 0)
                {
                    <div class="flex items-center text-gray-600">
                        <i class="fas fa-file-alt mr-1"></i>
                        <span>@Model.PageCount tr</span>
                    </div>
                }
            </div>
        }

        <!-- Price & Actions -->
        <div class="mt-auto pt-3 border-t border-gray-200">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <p class="text-2xl font-bold text-primary-600">
                        @Model.Price.ToString("N0") ₫
                    </p>
                    @if (Model.Price > Model.DisplayPrice)
                    {
                        <p class="text-sm text-gray-500 line-through">
                            @Model.DisplayPrice.ToString("N0") ₫
                        </p>
                    }
                </div>
                @if (Model.DisplayPrice > Model.Price)
                {
                    var discount = (int)(((Model.Price - Model.DisplayPrice) / Model.Price) * 100);
                    <span class="px-2 py-1 bg-red-500 text-white text-xs font-bold rounded">
                        -@discount%
                    </span>
                }
            </div>

            @if (isAdminContext)
            {
                <!-- Admin Actions -->
                <div class="flex gap-2">
                    <a href="@Url.Action("EditBook", "Admin", new { id = Model.Id })"
                        class="flex-1 px-3 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-700 transition-colors text-center">
                        <i class="fas fa-edit mr-1"></i>Chỉnh sửa
                    </a>
                    <a href="@Url.Action("Details", "Books", new { id = Model.Id })" target="_blank"
                        class="px-3 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
            }
            else
            {
                <!-- User Actions -->
                @if (Model.StockQuantity > 0)
                {
                    <button onclick="addToCart(@Model.Id)"
                        class="w-full px-4 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors">
                        <i class="fas fa-shopping-cart mr-2"></i>Thêm vào giỏ
                    </button>
                }
                else
                {
                    <button disabled
                        class="w-full px-4 py-2 bg-gray-300 text-gray-500 font-medium rounded-lg cursor-not-allowed">
                        <i class="fas fa-times-circle mr-2"></i>Hết hàng
                    </button>
                }
            }
        </div>
    </div>
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>