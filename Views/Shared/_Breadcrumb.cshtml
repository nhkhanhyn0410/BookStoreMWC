@* Views/Shared/_Breadcrumb.cshtml - Breadcrumb Navigation *@
@using BookStoreMVC.Models.ViewModels

@{
    var breadcrumbs = Html.GetBreadcrumbs();

    // Don't show breadcrumb if there are no items or only one item
    if (breadcrumbs == null || breadcrumbs.Count <= 1)
    {
        return;
    }
}

<nav class="bg-white border-b border-gray-200 px-6 py-3" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-sm">
        @for (int i = 0; i < breadcrumbs.Count; i++)
        {
            var item = breadcrumbs[i];
            var isLast = i == breadcrumbs.Count - 1;

            <li class="flex items-center">
                @if (i > 0)
                {
                    <i class="fas fa-chevron-right text-gray-400 text-xs mx-2"></i>
                }

                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    <span class="mr-2">
                        @Html.Raw(item.Icon)
                    </span>
                }

                @if (isLast)
                {
                    <span class="font-medium text-gray-900">@item.Title</span>
                }
                else if (!string.IsNullOrEmpty(item.Url))
                {
                    <a href="@item.Url" class="text-gray-600 hover:text-primary-600 transition-colors">
                        @item.Title
                    </a>
                }
                else
                {
                    <span class="text-gray-600">@item.Title</span>
                }
            </li>
        }
    </ol>
</nav>